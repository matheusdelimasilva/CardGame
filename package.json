{
  "name": "cardgame",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "test": "vitest run",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm --filter @cardgame/web build",
    "start": "pnpm --filter @cardgame/server start",
    "songs": "node tools/songs/scrape-billboard.mjs 1949 2025 && node tools/songs/fetch-musicbrainz.mjs && node tools/songs/build-songs.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
